{
  "name": "sdc-gestion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/publish-layout.mjs",
    "test": "vitest run",
    "dev:server": "vite --mode server",
    "api": "tsx watch src/server/node.ts",
    "start": "tsx src/server/node.ts",
    "server": "npm run build:server && npm run start",
    "build:html": "tsc -b && vite build --mode single && node scripts/inline-html.mjs dist-single index.html ../sistemas-de-carga-gestion.html",
    "build:server": "tsc -b && vite build --mode server",
    "build:cotizador": "tsc -b && vite build --mode cotizador && node scripts/inline-html.mjs dist-cotizador cotizador.html ../cotizador-3d.html"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/react-query": "^5.104.1",
    "hono": "^4.13.12",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sql.js": "^1.14.2",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
